var(--accent);font-weight:600}\n  .sum{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}\n  .sum.big{font-weight:600;font-size:1.12rem;color:var(--accent-ink);border-bottom:none}\n  .note{font-size:.82rem;color:var(--ink-soft);margin:10px 0 0}\n  .sec{font-size:1rem;font-weight:600;margin:28px 0 4px}\n  .ed{width:118px;text-align:right;border:none;border-bottom:1px solid transparent;background:transparent;color:var(--accent-ink);font:600 1.02rem 'Zilla Slab',serif;padding:2px 0}\n  .ed:hover,.ed:focus{border-bottom-color:var(--accent);outline:none}\n  .row-actions{flex-wrap:wrap}\n  details.add{margin-top:24px}\n  details.add summary{cursor:pointer;color:var(--accent);font-weight:500;margin-bottom:14px}\n  .field select{width:100%;padding:9px 0;border:none;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);font:inherit}\n  .chk{display:flex;gap:8px;align-items:center;font-size:.9rem;margin-bottom:14px}\n  .tag{font-size:.72rem;color:var(--ink-soft);margin-left:8px;font-weight:400}\n  #app:not(.animate) *{animation:none!important}\n</style>\n";
var $=function(i){return document.getElementById(i)};
var fmt=new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0});
var money=function(n){return fmt.format(Math.round(n||0))};
var esc=function(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
var sum=function(a,f){return a.reduce(function(t,x){return t+(f?f(x):x.monto)},0)};
var uid=function(){return 'i'+Date.now().toString(36)+Math.random().toString(36).slice(2,6)};
var TABS=[['resumen','Resumen'],['ingresos','Ingresos'],['mes','Gastos del mes'],['anuales','Gastos anuales']];
var tab='resumen',state=JSON.parse($('state-data').textContent),app=$('app'),api=null;
['ingresos','fijos','variables','anuales'].forEach(function(k){state[k]=state[k]||[]});
function hoy(){var t=new Date();t.setHours(0,0,0,0);return t}
function anual(it){
  if(!it.mes)return{sin:1,pend:it.monto,porQ:it.monto/24};
  var h=hoy(),y=h.getFullYear(),f=new Date(y,it.mes-1,it.dia);if(f<h)f=new Date(y+1,it.mes-1,it.dia);
  var d=Math.round((f-h)/864e5),ab=it.ciclo===f.getFullYear()?(it.abonado||0):0,p=Math.max(0,it.monto-ab);
  return{f:f,d:d,ab:ab,pend:p,porQ:p/Math.max(1,Math.ceil(d/15))};
}
function calc(s){
  var ing=sum(s.ingresos),fij=sum(s.fijos),vr=sum(s.variables),sal=fij+vr,an=sum(s.anuales),gfa=an/12;
  var its=s.anuales.map(function(x){return{x:x,c:anual(x)}});
  return{ing:ing,fij:fij,vr:vr,sal:sal,an:an,gfa:gfa,its:its,
    ali:sum(s.fijos.filter(function(x){return x.ali}))/2,ap:sum(its,function(i){return i.c.porQ}),sq:(ing-sal)/2,sobra:ing-sal-gfa};
}
function inp(l,id,v){return '<input class="ed" type="number" min="0" step="1000" value="'+v+'" data-ed="'+l+'" data-id="'+id+'" aria-label="Monto">'}
function del(l,id,t){return '<button class="btn-ghost" data-act="del" data-list="'+l+'" data-id="'+id+'">'+(t||'Eliminar')+'</button>'}
function row(l,it,meta,extra){return '<div class="row"><div class="who"><p class="nombre">'+esc(it.nombre)+(it.ali?'<span class="tag">alimentación</span>':'')+'</p><p class="meta">'+meta+'</p></div><div class="cifras">'+(extra||inp(l,it.id,it.monto))+'<div class="row-actions">'+del(l,it.id)+'</div></div></div>'}
function field(id,lab,attrs){return '<div class="field"><label for="'+id+'">'+lab+'</label><input id="'+id+'" '+attrs+'></div>'}
function sumRow(a,b,big){return '<div class="sum'+(big?' big':'')+'"><span>'+a+'</span><span class="num">'+b+'</span></div>'}
function body(s,t){
  var c=calc(s),h='<div class="wrap"><header class="top"><h1>Mi cuenta quincenal</h1></header><div class="tabs" role="tablist">'+
  TABS.map(function(x){return '<button class="tab" role="tab" aria-selected="'+(x[0]===t)+'" data-tab="'+x[0]+'">'+x[1]+'</button>'}).join('')+'</div>';
  if(t==='resumen'){
    var nx=c.its.filter(function(i){return !i.c.sin&&i.c.pend>0}).sort(function(a,b){return a.c.d-b.c.d})[0];
    h+='<div class="hero"><p class="label">Aparta esta quincena para tus gastos anuales</p><p class="num">'+money(c.ap)+'</p><p class="sub'+(c.sq>0&&c.ap>c.sq?' warn':'')+'">'+
    (nx?'Lo más cercano: '+esc(nx.x.nombre)+', el '+nx.c.f.toLocaleDateString('es-CO',{day:'numeric',month:'long'})+' (en '+nx.c.d+' días). ':'')+
    (c.sq>0&&c.ap>c.sq?'Es más de lo que te sobra por quincena después de tus gastos del mes ('+money(c.sq)+').':'Si ya tienes plata apartada, regístrala con Abonar en Gastos anuales.')+'</p></div>'+
    sumRow('Ingresos totales',money(c.ing))+sumRow('Salidas totales (gastos del mes)',money(c.sal))+sumRow('Gastos fijos anuales',money(c.an))+
    sumRow('Ahorro mensual de gastos anuales (÷ 12)',money(c.gfa))+sumRow('Alimentación quincenal',money(c.ali))+sumRow('Te sobra al mes',money(c.sobra),1)+
    '<p class="note">Te sobra = ingresos − salidas − ahorro mensual de gastos anuales.</p>';
  }else if(t==='ingresos'){
    h+='<div class="panel-right"><h2>Ingresos</h2><p class="count">Total: '+money(c.ing)+'</p>'+
    (s.ingresos.map(function(i){return row('ingresos',i,'Llega: '+esc(i.cuando||'—'))}).join('')||'<p class="empty">Aún no hay ingresos.</p>')+
    '<details class="add"><summary>Agregar ingreso</summary>'+field('f-n','Nombre','type="text" placeholder="Ej. Quincena"')+field('f-m','Cuánto llega','type="number" min="0" step="1000"')+field('f-c','Cuándo llega','type="text" placeholder="15 de cada mes"')+'<button class="btn-primary" data-act="add-ingreso">Agregar</button></details></div>';
  }else if(t==='mes'){
    h+='<div class="panel-right"><h2>Gastos fijos del mes</h2><p class="count">Total: '+money(c.fij)+'</p>'+
    (s.fijos.map(function(i){return row('fijos',i,'Cada mes')}).join('')||'<p class="empty">Sin gastos fijos.</p>')+
    '<p class="sec">Gastos variables</p><p class="count">Total: '+money(c.vr)+'</p>'+
    (s.variables.map(function(i){return row('variables',i,'Varía cada mes')}).join('')||'<p class="empty">Sin gastos variables.</p>')+
    '<details class="add"><summary>Agregar gasto</summary>'+field('f-n','Nombre','type="text" placeholder="Ej. Internet"')+field('f-m','Monto','type="number" min="0" step="1000"')+
    '<div class="field"><label for="f-t">Tipo</label><select id="f-t"><option value="fijos">Fijo</option><option value="variables">Variable</option></select></div>'+
    '<label class="chk"><input type="checkbox" id="f-a"> Es de alimentación</label><button class="btn-primary" data-act="add-mes">Agregar</button></details></div>';
  }else{
    var its=c.its.slice().sort(function(a,b){return (a.c.f||9e15)-(b.c.f||9e15)});
    h+='<div class="panel-right"><h2>Gastos anuales</h2><p class="count">Total del año: '+money(c.an)+'</p>'+
    (its.map(function(i){var x=i.x,k=i.c,meta=k.sin?'Según necesidad':'Se paga el '+k.f.toLocaleDateString('es-CO',{day:'numeric',month:'long'})+' (en '+k.d+' días)'+(k.ab?' · ya apartaste '+money(k.ab):'');
      var ex='<div class="por-quincena num">'+(k.pend>0?money(k.porQ)+' / quincena':'✓ completo')+'</div>'+(!k.sin&&k.pend>0?'<div class="pendiente">faltan '+money(k.pend)+'</div>':'')+'<div class="pendiente">Total '+inp('anuales',x.id,x.monto)+'</div>'+
      (k.sin?'':'<div class="row-actions"><input type="number" min="0" step="1000" placeholder="Abonar $" id="ab-'+x.id+'"><button class="btn-ghost" data-act="abonar" data-id="'+x.id+'">Abonar</button></div>');
      return row('anuales',x,meta,ex)}).join('')||'<p class="empty">Aún no hay gastos anuales.</p>')+
    '<details class="add"><summary>Agregar gasto anual</summary>'+field('f-n','Nombre','type="text" placeholder="Ej. SOAT moto"')+field('f-m','Monto','type="number" min="0" step="1000"')+field('f-d','Fecha de pago (vacía si es según necesidad)','type="date"')+'<button class="btn-primary" data-act="add-anual">Agregar</button></details></div>';
  }
  return h+'</div>';
}
function render(a){app.className=a?'animate':'';app.innerHTML=body(state,tab)}
function full(){return '<!DOCTYPE html>\n<html lang="es">\n<head>\n'+HEAD+'</head>\n<body>\n<div id="app">'+body(state,'resumen')+'</div>\n<script id="state-data" type="application/json">'+JSON.stringify(state).replace(/</g,'\\u003c')+'<\/script>\n'+SELF+'\n</body>\n</html>'}
function commit(){render(false);$('state-data').textContent=JSON.stringify(state);if(api&&api.publish)api.publish(full()).catch(function(){})}
function v(id){var e=$(id);return e?e.value.trim():''}
app.addEventListener('change',function(e){var l=e.target.getAttribute('data-ed');if(!l)return;var it=state[l].find(function(x){return x.id===e.target.getAttribute('data-id')});if(it){it.monto=Number(e.target.value)||0;commit()}});
app.addEventListener('click',function(e){
  var t=e.target,a=t.getAttribute('data-act'),tb=t.getAttribute('data-tab');
  if(tb){tab=tb;render(true);return}
  if(!a)return;
  var n=v('f-n'),m=Number(v('f-m'))||0;
  if(a==='del'){var l=t.getAttribute('data-list'),id=t.getAttribute('data-id');state[l]=state[l].filter(function(x){return x.id!==id});commit()}
  else if(a==='add-ingreso'){if(!n||m<=0)return;state.ingresos.push({id:uid(),nombre:n,monto:m,cuando:v('f-c')});commit()}
  else if(a==='add-mes'){if(!n||m<=0)return;var k=v('f-t')||'fijos',o={id:uid(),nombre:n,monto:m};if(k==='fijos'&&$('f-a').checked)o.ali=1;state[k].push(o);commit()}
  else if(a==='add-anual'){if(!n||m<=0)return;var d=v('f-d').split('-'),o={id:uid(),nombre:n,monto:m,abonado:0,mes:d[1]?+d[1]:0,dia:d[2]?+d[2]:0};state.anuales.push(o);commit()}
  else if(a==='abonar'){var id=t.getAttribute('data-id'),x=state.anuales.find(function(z){return z.id===id}),ab=Number(v('ab-'+id))||0,k=x&&anual(x);if(!x||ab<=0)return;var y=k.f.getFullYear();x.abonado=(x.ciclo===y?(x.abonado||0):0)+ab;x.ciclo=y;commit()}
});
render(true);
if(window.claude&&window.claude.use)window.claude.use('artifact').then(function(a){api=a}).catch(function(){});
})();
</script>
</body>
</html>
